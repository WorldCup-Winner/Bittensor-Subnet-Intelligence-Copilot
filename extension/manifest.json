{
  "manifest_version": 3,
  "name": "TAO Scout",
  "version": "1.0.2",
  "description": "Bittensor subnet intelligence — analyze, compare, and decide if a subnet is worth researching.",
  "permissions": [
    "storage",
    "activeTab",
    "sidePanel",
    "tabs",
    "alarms"
  ],
  "host_permissions": [
    "https://api.taostats.io/*",
    "https://api.openai.com/*",
    "https://*.taostats.io/*",
    "https://*.bittensor.com/*",
    "https://*.tao.app/*",
    "https://*.taomarketcap.com/*"
  ],
  "background": {
    "service_worker": "background/service-worker.js",
    "type": "module"
  },
  "content_scripts": [
    {
      "matches": [
        "https://*.taostats.io/*",
        "https://taostats.io/*",
        "https://*.bittensor.com/*",
        "https://bittensor.com/*",
        "https://*.tao.app/*",
        "https://tao.app/*",
        "https://*.taomarketcap.com/*",
        "https://taomarketcap.com/*"
      ],
      "js": ["content/content.js"],
      "css": ["content/content.css"],
      "run_at": "document_idle"
    }
  ],
  "side_panel": {
    "default_path": "sidepanel/sidepanel.html"
  },
  "action": {
    "default_title": "TAO Scout — Analyze subnet",
    "default_icon": {
      "16": "assets/icon-16.png",
      "48": "assets/icon-48.png",
      "128": "assets/icon-128.png"
    }
  },
  "options_page": "options/options.html",
  "icons": {
    "16": "assets/icon-16.png",
    "48": "assets/icon-48.png",
    "128": "assets/icon-128.png"
  }
}
